# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./neoshop.db
# Fallback SQLite for development (uncomment if no MySQL):
# DATABASE_URL=sqlite:///./neoshop.db

# ─── JWT ──────────────────────────────────────────────────────────────────────
SECRET_KEY=your-super-secret-jwt-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ─── MQTT Broker ──────────────────────────────────────────────────────────────
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_USERNAME=neoshop
MQTT_PASSWORD=neoshop_mqtt_pass

# ─── Server ───────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
ENV=development
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000,http://raspberrypi.local:5173,http://192.168.0.138:5173,http://127.0.1.1:3000
# ─── CV / YOLO ────────────────────────────────────────────────────────────────
YOLO_MODEL_PATH=yolov8n.pt
CAMERA_STREAM_URL=0

# ─── Admin ────────────────────────────────────────────────────────────────────
ADMIN_EMAILS=admin@neoshop.com,owner@neoshop.com
